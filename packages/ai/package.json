{
	"name": "@candy/ai",
	"version": "0.87.1",
	"description": "Unified LLM API with automatic model discovery and provider configuration",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./providers/*": {
			"types": "./dist/providers/*.d.ts",
			"import": "./dist/providers/*.js"
		},
		"./api/*": {
			"types": "./dist/api/*.d.ts",
			"import": "./dist/api/*.js"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.js"
		},
		"./bun-oauth": {
			"types": "./dist/bun-oauth.d.ts",
			"import": "./dist/bun-oauth.js"
		}
	},
	"bin": {
		"candy-ai": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"docs"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"generate-models": "node scripts/generate-models.ts --strict",
		"hydrate-model-data": "node scripts/generate-models.ts --strict --data-only",
		"check:model-data": "node scripts/check-model-data.ts",
		"build": "npm run check:model-data && tsc -p tsconfig.build.json && node -e \"const fs = require('node:fs'); fs.rmSync('dist/providers/data', { recursive: true, force: true }); fs.cpSync('src/providers/data', 'dist/providers/data', { recursive: true })\"",
		"test": "vitest --run",
		"test:e2e": "vitest --run --config vitest.e2e.config.ts",
		"probe:codex-websocket": "node --experimental-strip-types scripts/codex-websocket-cached-probe.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.124.0",
		"@google/genai": "2.21.0",
		"openai": "7.23.0",
		"partial-json": "0.1.7",
		"typebox": "1.3.27"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"anthropic",
		"gemini",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ce-daros/Candy.git",
		"directory": "packages/ai"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}

{
	"name": "@candy/coding-agent",
	"version": "0.87.1",
	"description": "Coding agent CLI with read, bash, edit, write tools and session management",
	"type": "module",
	"candyConfig": {
		"name": "candy",
		"configDir": ".candy"
	},
	"bin": {
		"candy": "dist/bundle/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rpc-entry": {
			"import": "./dist/bundle/rpc-entry.js"
		},
		"./extension-host-modules": {
			"types": "./dist/presentation/extensions/virtual-modules.d.ts",
			"import": "./dist/presentation/extensions/virtual-modules.js"
		},
		"./ui": {
			"types": "./dist/ui.d.ts",
			"import": "./dist/ui.js"
		},
		"./rpc": {
			"types": "./dist/rpc.d.ts",
			"import": "./dist/rpc.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"examples",
		"CHANGELOG.md",
		"npm-shrinkwrap.json"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run build:unbundled && node ../../scripts/build-coding-agent-bundle.mjs",
		"build:unbundled": "tsc -p tsconfig.build.json && npm run copy-assets",
		"build:binary": "npm --prefix ../tui run build && npm --prefix ../ai run build && npm --prefix ../agent run build && npm --prefix ../codemode run build && npm run build && bun build --compile --no-compile-autoload-bunfig ./src/bun/cli.ts ./src/utils/image-resize-worker.ts ./src/utils/codemode-worker.ts --outfile dist/candy && npm run copy-binary-assets",
		"copy-assets": "node ../../scripts/copy-coding-agent-assets.mjs",
		"copy-binary-assets": "node ../../scripts/copy-coding-agent-assets.mjs --binary",
		"test": "vitest --run",
		"test:bun": "bun test ./test/http-dispatcher.bun.test.mjs",
		"test:e2e": "vitest --run --config vitest.e2e.config.ts",
		"probe:codex-cache": "node --experimental-strip-types scripts/sdk-codex-cache-probe-tool-loop.ts",
		"example:rpc": "node --experimental-strip-types examples/rpc-example.ts",
		"shrinkwrap": "node ../../scripts/generate-coding-agent-shrinkwrap.mjs",
		"prepublishOnly": "npm run clean && npm run build && npm run shrinkwrap"
	},
	"dependencies": {
		"@candy/agent-core": "^0.87.1",
		"@candy/ai": "^0.87.1",
		"@candy/codemode": "^0.87.1",
		"@candy/tui": "^0.87.1",
		"@modelcontextprotocol/client": "2.3.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"brace-expansion": "5.0.12",
		"chalk": "6.0.0",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"grok-mermaid": "0.2.3",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.8",
		"jiti": "2.7.0",
		"minimatch": "10.2.6",
		"proper-lockfile": "4.1.2",
		"semver": "7.8.5",
		"typebox": "1.3.27",
		"undici": "8.10.2",
		"yaml": "2.9.0",
		"zod": "4.6.5"
	},
	"overrides": {
		"protobufjs": "7.6.6"
	},
	"devDependencies": {
		"@modelcontextprotocol/server": "2.3.0",
		"@types/cross-spawn": "6.0.6",
		"@types/hosted-git-info": "3.0.5",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"marked": "18.0.11"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ce-daros/Candy.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}

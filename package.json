{
	"name": "candy-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"packages/coding-agent/test/fixtures/with-deps"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "npm --prefix packages/tui run build && npm --prefix packages/ai run build && npm --prefix packages/agent run build && npm --prefix packages/coding-agent run build",
		"check": "biome check --error-on-warnings . && npm run check:pinned-deps && npm run check:runtime-deps && npm run check:ts-imports && npm run check:source-graphs && npm run check:shrinkwrap && tsc --noEmit",
		"format": "biome format --write .",
		"check:pinned-deps": "node scripts/check-pinned-deps.mjs",
		"check:runtime-deps": "node scripts/check-runtime-deps.mjs",
		"check:package-install": "node scripts/coding-agent-consumer.mjs",
		"check:shrinkwrap": "node scripts/generate-coding-agent-shrinkwrap.mjs --check",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"check:entry-graphs": "node scripts/check-source-graphs.mjs --rule entry-graphs",
		"check:architecture": "node scripts/check-source-graphs.mjs --rule architecture",
		"generate:models": "npm --prefix packages/ai run generate-models",
		"hydrate:model-data": "npm --prefix packages/ai run hydrate-model-data",
		"check:model-data": "npm --prefix packages/ai run check:model-data",
		"eval": "npm run eval --workspace=@candy/evals --",
		"profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
		"profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
		"test": "npm run test:scripts && npm run test --workspaces --if-present",
		"test:e2e": "npm --prefix packages/ai run test:e2e",
		"test:scripts": "node --test scripts/*.test.mjs",
		"prepare": "husky",
		"check:source-graphs": "node scripts/check-source-graphs.mjs"
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.26",
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"esbuild": "0.28.2",
		"husky": "9.1.7",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.3",
	"overrides": {
		"protobufjs": "7.6.6"
	}
}
